# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Provider selection is done in code (OpenRouter::from_env / Anthropic::from_env
# / OpenAi::from_env); each reads its own key + model slug from here.

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
