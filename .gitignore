# Rust
/target/
**/*.rs.bk

node_modules/
.DS_Store

# Secrets — never commit
.env
*.env
!.env.example

# The local config scope (0.19.0). `io.toml` is committed and inherited by
# everyone on the team; this one is a single person's overrides and the whole
# scope split fails the moment it is shared.
io.local.toml

# UltraShip: release gate evidence and deploy/publish hook output. Local only,
# never committed. The canonical location is the product tree below — the second
# line exists because ignoring the first one is what pushed evidence out to the
# workspace root in the first place. Both stay ignored; neither is a place to
# "rescue" evidence into git.
.ultraship/products/*/evidence/
.ultraship/evidence/
